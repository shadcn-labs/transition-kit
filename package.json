{
  "name": "transition-kit",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://transition-kit.space",
  "bugs": {
    "url": "https://github.com/shadcn-labs/transition-kit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shadcn-labs/transition-kit.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "pnpm registry:build && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "registry:build": "node scripts/build-registry.ts && shadcn build registry.json --output ./public/r",
    "postinstall": "fumadocs-mdx",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@mdx-js/mdx": "^3.1.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@web-kits/audio": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "^16.8.4",
    "fumadocs-mdx": "^14.3.1",
    "jotai": "^2.19.1",
    "lru-cache": "^11.3.5",
    "lucide-react": "1.11.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hotkeys-hook": "^5.2.4",
    "rehype-pretty-code": "^0.14.3",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "web-haptics": "^0.0.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "postcss": "^8.5.29",
    "shadcn": "4.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "ultracite": "7.6.1",
    "vite": "^8.3.3",
    "wrangler": "^4.70.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "workerd"
    ],
    "overrides": {
      "mdast-util-to-markdown": "2.1.2"
    }
  }
}
