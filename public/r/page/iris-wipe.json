{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "page/iris-wipe",
  "title": "Iris Wipe",
  "description": "An iris closes on the old page and opens on the new one.",
  "registryDependencies": [
    "https://transition-kit.space/r/page/page-transition.json"
  ],
  "css": {
    "::view-transition-image-pair(.tk-page-iris-wipe.tk-page-exit)": {
      "--tk-page-x": "calc( (max(0px, var(--tk-exit-cx) - 50vw) + min(100%, var(--tk-exit-cx) + 50vw)) / 2 )",
      "--tk-page-y": "calc( (max(0px, var(--tk-exit-cy) - 50vh) + min(100%, var(--tk-exit-cy) + 50vh)) / 2 )"
    },
    "::view-transition-image-pair(.tk-page-iris-wipe.tk-page-enter)": {
      "--tk-page-x": "calc( ( max(0px, var(--tk-enter-cx) - 50vw) + min(100%, var(--tk-enter-cx) + 50vw) ) / 2 )",
      "--tk-page-y": "calc( ( max(0px, var(--tk-enter-cy) - 50vh) + min(100%, var(--tk-enter-cy) + 50vh) ) / 2 )"
    },
    "::view-transition-old(.tk-page-iris-wipe), ::view-transition-new(.tk-page-iris-wipe)": {
      "--tk-page-r": "min(71%, hypot(50vw, 50vh))"
    },
    "::view-transition-old(.tk-page-iris-wipe)": {
      "animation": "tk-page-iris-wipe-close calc(var(--tk-page-duration, 700ms) / 2) var(--tk-page-easing, ease-in) both"
    },
    "::view-transition-new(.tk-page-iris-wipe)": {
      "animation": "tk-page-iris-wipe-open calc(var(--tk-page-duration, 700ms) / 2) var(--tk-page-easing, ease-out) calc(var(--tk-page-duration, 700ms) / 2) both"
    },
    "@keyframes tk-page-iris-wipe-close": {
      "from": {
        "clip-path": "circle(var(--tk-page-r) at var(--tk-page-x) var(--tk-page-y))"
      },
      "to": {
        "clip-path": "circle(0 at var(--tk-page-x) var(--tk-page-y))"
      }
    },
    "@keyframes tk-page-iris-wipe-open": {
      "from": {
        "clip-path": "circle(0 at var(--tk-page-x) var(--tk-page-y))"
      },
      "to": {
        "clip-path": "circle(var(--tk-page-r) at var(--tk-page-x) var(--tk-page-y))"
      }
    }
  },
  "categories": [
    "page"
  ],
  "type": "registry:item"
}