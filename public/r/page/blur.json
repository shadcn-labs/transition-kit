{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "page/blur",
  "title": "Blur",
  "description": "The old page blurs away while the new one sharpens in.",
  "registryDependencies": [
    "https://transition-kit.space/r/page/page-transition.json"
  ],
  "css": {
    "::view-transition-image-pair(.tk-page-blur.tk-page-exit)": {
      "--tk-page-x": "calc( (max(0px, var(--tk-exit-cx) - 50vw) + min(100%, var(--tk-exit-cx) + 50vw)) / 2 )",
      "--tk-page-y": "calc( (max(0px, var(--tk-exit-cy) - 50vh) + min(100%, var(--tk-exit-cy) + 50vh)) / 2 )"
    },
    "::view-transition-image-pair(.tk-page-blur.tk-page-enter)": {
      "--tk-page-x": "calc( ( max(0px, var(--tk-enter-cx) - 50vw) + min(100%, var(--tk-enter-cx) + 50vw) ) / 2 )",
      "--tk-page-y": "calc( ( max(0px, var(--tk-enter-cy) - 50vh) + min(100%, var(--tk-enter-cy) + 50vh) ) / 2 )"
    },
    "::view-transition-old(.tk-page-blur), ::view-transition-new(.tk-page-blur)": {
      "transform-origin": "var(--tk-page-x) var(--tk-page-y)"
    },
    "::view-transition-old(.tk-page-blur)": {
      "animation": "tk-page-blur-out var(--tk-page-duration, 500ms) var(--tk-page-easing, ease-in-out) both"
    },
    "::view-transition-new(.tk-page-blur)": {
      "animation": "tk-page-blur-in var(--tk-page-duration, 500ms) var(--tk-page-easing, ease-in-out) both"
    },
    "@keyframes tk-page-blur-out": {
      "from": {
        "filter": "blur(0)",
        "opacity": "1",
        "transform": "scale(1)"
      },
      "to": {
        "filter": "blur(12px)",
        "opacity": "0",
        "transform": "scale(1.02)"
      }
    },
    "@keyframes tk-page-blur-in": {
      "from": {
        "filter": "blur(12px)",
        "opacity": "0",
        "transform": "scale(0.98)"
      },
      "to": {
        "filter": "blur(0)",
        "opacity": "1",
        "transform": "scale(1)"
      }
    }
  },
  "categories": [
    "page"
  ],
  "type": "registry:item"
}