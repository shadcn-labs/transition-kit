{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "page/page-curl",
  "title": "Page Curl",
  "description": "The old page curls up from the corner like a book page.",
  "registryDependencies": [
    "https://transition-kit.space/r/page/page-transition.json"
  ],
  "css": {
    "::view-transition-image-pair(.tk-page-page-curl.tk-page-exit)": {
      "--tk-page-x": "calc( (max(0px, var(--tk-exit-cx) - 50vw) + min(100%, var(--tk-exit-cx) + 50vw)) / 2 )",
      "--tk-page-y": "calc( (max(0px, var(--tk-exit-cy) - 50vh) + min(100%, var(--tk-exit-cy) + 50vh)) / 2 )",
      "--tk-page-left": "max(0px, var(--tk-exit-cx) - 50vw)",
      "--tk-page-right": "min(100%, var(--tk-exit-cx) + 50vw)",
      "--tk-page-bottom": "min(100%, var(--tk-exit-cy) + 50vh)"
    },
    "::view-transition-image-pair(.tk-page-page-curl.tk-page-enter)": {
      "--tk-page-x": "calc( ( max(0px, var(--tk-enter-cx) - 50vw) + min(100%, var(--tk-enter-cx) + 50vw) ) / 2 )",
      "--tk-page-y": "calc( ( max(0px, var(--tk-enter-cy) - 50vh) + min(100%, var(--tk-enter-cy) + 50vh) ) / 2 )",
      "--tk-page-left": "max(0px, var(--tk-enter-cx) - 50vw)",
      "--tk-page-right": "min(100%, var(--tk-enter-cx) + 50vw)",
      "--tk-page-bottom": "min(100%, var(--tk-enter-cy) + 50vh)"
    },
    "::view-transition-group(.tk-page-page-curl.tk-page-exit)": {
      "z-index": "1"
    },
    "::view-transition-image-pair(.tk-page-page-curl)": {
      "perspective": "1400px",
      "perspective-origin": "var(--tk-page-x) var(--tk-page-y)"
    },
    "::view-transition-old(.tk-page-page-curl)": {
      "--tk-page-dir": "1",
      "transform-origin": "var(--tk-page-right) var(--tk-page-bottom)",
      "animation": "tk-page-page-curl-out var(--tk-page-duration, 650ms) var(--tk-page-easing, ease-in) both"
    },
    "::view-transition-old(.tk-page-page-curl.tk-page-back)": {
      "--tk-page-dir": "-1",
      "transform-origin": "var(--tk-page-left) var(--tk-page-bottom)"
    },
    "::view-transition-new(.tk-page-page-curl)": {
      "transform-origin": "var(--tk-page-x) var(--tk-page-y)",
      "animation": "tk-page-page-curl-in var(--tk-page-duration, 650ms) var(--tk-page-easing, ease-out) both"
    },
    "@keyframes tk-page-page-curl-out": {
      "from": {
        "transform": "rotateX(0deg) rotateY(0deg)",
        "opacity": "1"
      },
      "to": {
        "transform": "rotateX(20deg) rotateY(calc(-70deg * var(--tk-page-dir)))",
        "opacity": "0"
      }
    },
    "@keyframes tk-page-page-curl-in": {
      "from": {
        "transform": "scale(0.96)",
        "opacity": "0.4"
      },
      "to": {
        "transform": "scale(1)",
        "opacity": "1"
      }
    }
  },
  "categories": [
    "page"
  ],
  "type": "registry:item"
}