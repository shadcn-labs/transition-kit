{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "page/curtain",
  "title": "Curtain",
  "description": "The new page opens out of a centre strip as the old one closes into it.",
  "registryDependencies": [
    "https://transition-kit.space/r/page/page-transition.json"
  ],
  "css": {
    "::view-transition-image-pair(.tk-page-curtain.tk-page-exit)": {
      "--tk-page-x": "calc( (max(0px, var(--tk-exit-cx) - 50vw) + min(100%, var(--tk-exit-cx) + 50vw)) / 2 )"
    },
    "::view-transition-image-pair(.tk-page-curtain.tk-page-enter)": {
      "--tk-page-x": "calc( ( max(0px, var(--tk-enter-cx) - 50vw) + min(100%, var(--tk-enter-cx) + 50vw) ) / 2 )"
    },
    "::view-transition-old(.tk-page-curtain)": {
      "animation": "tk-page-curtain-out var(--tk-page-duration, 600ms) var(--tk-page-easing, cubic-bezier(0.65, 0, 0.35, 1)) both"
    },
    "::view-transition-new(.tk-page-curtain)": {
      "animation": "tk-page-curtain-in var(--tk-page-duration, 600ms) var(--tk-page-easing, cubic-bezier(0.65, 0, 0.35, 1)) both"
    },
    "@keyframes tk-page-curtain-out": {
      "from": {
        "clip-path": "inset(0 0 0 0)",
        "opacity": "1"
      },
      "to": {
        "clip-path": "inset(0 calc(100% - var(--tk-page-x)) 0 var(--tk-page-x))",
        "opacity": "0"
      }
    },
    "@keyframes tk-page-curtain-in": {
      "from": {
        "clip-path": "inset(0 calc(100% - var(--tk-page-x)) 0 var(--tk-page-x))"
      },
      "to": {
        "clip-path": "inset(0 0 0 0)"
      }
    }
  },
  "categories": [
    "page"
  ],
  "type": "registry:item"
}