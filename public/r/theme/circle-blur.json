{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme/circle-blur",
  "title": "Circle Blur",
  "description": "A soft, blurred circle expands from the click point.",
  "registryDependencies": [
    "https://transition-kit.space/r/theme/theme-transition.json"
  ],
  "css": {
    "::view-transition-old(.tk-theme-circle-blur)": {
      "animation": "none"
    },
    "::view-transition-new(.tk-theme-circle-blur)": {
      "mask-image": "url('data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 40 40\"><defs><filter id=\"blur\"><feGaussianBlur stdDeviation=\"2\"/></filter></defs><circle cx=\"20\" cy=\"20\" r=\"18\" fill=\"white\" filter=\"url(%23blur)\"/></svg>')",
      "mask-repeat": "no-repeat",
      "mask-position": "var(--tk-x) var(--tk-y)",
      "mask-size": "0",
      "animation": "tk-theme-circle-blur var(--tk-theme-duration, 1000ms) var(--tk-theme-easing, cubic-bezier(0.16, 1, 0.3, 1)) both"
    },
    "@keyframes tk-theme-circle-blur": {
      "from": {
        "mask-size": "0",
        "mask-position": "var(--tk-x) var(--tk-y)"
      },
      "to": {
        "mask-size": "calc(var(--tk-r) * 3.5)",
        "mask-position": "calc(var(--tk-x) - var(--tk-r) * 1.75) calc(var(--tk-y) - var(--tk-r) * 1.75)"
      }
    }
  },
  "categories": [
    "theme"
  ],
  "type": "registry:item"
}